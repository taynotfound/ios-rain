From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: taynotfound <marztayron@gmail.com>
Date: Wed, 11 Nov 2026 19:10:00 +0100
Subject: [PATCH] rain-0982: touch C13, 3 s statistics and exact canvas mapping

Keys reach iOS and the lock screen is live, touch does nothing, and C12
counted two contacts in its first frame. raintouchpanic=3 collects 3 s
from the first contact (frames, empty frames, most simultaneous contacts,
ids seen, finger 1 start/end, HID down/up counts, first frame's records)
and panics. Map through the 1125x2436 canvas the way SweetHID.cpp adds
its origin: x*1125/720 - 20, (y-45)*2436/1559 - 18.
---
diff --git a/bsd/dev/sweet_touch.c b/bsd/dev/sweet_touch.c
index d988b5d..86f8ff9 100644
--- a/bsd/dev/sweet_touch.c
+++ b/bsd/dev/sweet_touch.c
@@ -1303,6 +1303,10 @@ static struct {
 	uint8_t info[12];
 	uint32_t polls, downs, fx, fy, lx, ly;
 	uint8_t raw[7];
+	/* raintouchpanic=3: 3 s of statistics from the first contact */
+	uint32_t t3_frames, t3_max, t3_ids, t3_empty;
+	uint8_t t3_first[18];             /* first frame: up to 3 valid records */
+	uint32_t t3_x0, t3_y0, t3_x1, t3_y1;   /* finger id 1: first and last panel position */
 } nf;
 
 static int
@@ -1472,14 +1476,14 @@ rain_nvt_bringup(void)
 /*
  * C11: the driver loop. 10 fingers of 6 bytes at EVENT_BUF: id (1..10) << 3 | status
  * (1 enter, 2 move), x[11:4], y[11:4], x[3:0] << 4 | y[3:0]. Panel pixels 720x1650.
- * sweet_hid_touch divides by 1080x2400 and iOS is drawn into 720x1559 at y = 45
- * (sweetfb_fit), so x * 3/2 and (y - 45) * 2400/1559.
+ * iOS's 1125x2436 canvas is drawn into 720x1559 at y = 45 (sweetfb_fit); sweet_hid_touch
+ * wants 1080x2400 panel pixels and adds the canvas origin (20, 18) itself (SweetHID.cpp).
  */
 static void rain_touch_report(void);
 
-/* stop_on_touch (raintouchpanic=2): panic at the first finger with its raw record */
+/* stop (raintouchpanic): 2 = panic at the first finger, 3 = panic 3 s after it with statistics */
 static void
-rain_touch_run(bool stop_on_touch)
+rain_touch_run(unsigned stop)
 {
 	uint8_t pd[60];
 	unsigned errs = 0;
@@ -1502,6 +1506,7 @@ rain_touch_run(bool stop_on_touch)
 		}
 		errs = 0;
 		nf.polls++;
+		unsigned nvalid = 0;
 		for (unsigned i = 0; i < TOUCH_MAX; i++) {
 			const uint8_t *f = pd + 6u * i;
 			unsigned id = f[0] >> 3, status = f[0] & 7u;
@@ -1510,9 +1515,23 @@ rain_touch_run(bool stop_on_touch)
 			if (id < 1 || id > TOUCH_MAX || (status != 1 && status != 2) || px > 719 || py > 1649) {
 				continue;
 			}
-			unsigned ly = py < 45 ? 0 : (py - 45u) * 2400u / 1559u;
-			x[id - 1] = (int)(px * 3u / 2u);
-			y[id - 1] = (int)(ly > 2399 ? 2399 : ly);
+			int hx = (int)(px * 1125u / 720u) - 20;
+			int hy = (py < 45 ? 0 : (int)((py - 45u) * 2436u / 1559u)) - 18;
+			x[id - 1] = hx < 0 ? 0 : (hx > 1079 ? 1079 : hx);
+			y[id - 1] = hy < 0 ? 0 : (hy > 2399 ? 2399 : hy);
+			if (!nf.t3_frames && nvalid < 3) {
+				memcpy(nf.t3_first + 6u * nvalid, f, 6);
+			}
+			nvalid++;
+			nf.t3_ids |= 1u << id;
+			if (id == 1) {
+				if (!nf.t3_frames) {
+					nf.t3_x0 = px;
+					nf.t3_y0 = py;
+				}
+				nf.t3_x1 = px;
+				nf.t3_y1 = py;
+			}
 			mask |= 1u << (id - 1);
 			if (!nf.downs++) {
 				nf.fx = px;
@@ -1523,10 +1542,18 @@ rain_touch_run(bool stop_on_touch)
 			nf.lx = (uint32_t)x[id - 1];
 			nf.ly = (uint32_t)y[id - 1];
 		}
-		if (stop_on_touch && mask) {
+		if (stop == 2 && mask) {
 			rain_touch_report();
 		}
+		if (nf.downs) {
+			nf.t3_frames++;
+			nf.t3_empty += !mask;
+			nf.t3_max = nvalid > nf.t3_max ? nvalid : nf.t3_max;
+		}
 		touch_report(mask, x, y);
+		if (stop == 3 && nf.t3_frames >= 300) {
+			rain_touch_report();
+		}
 		touch_wait(10);
 	}
 }
@@ -1729,9 +1756,9 @@ rain_touch_report(void)
 		rain_reboot_fastboot();
 	}
 	rain_smmu_cbscan();
-	panic("RAIN TOUCH C12: step %u '%s' err=%d xf=%u smmu=%d cb=%d | SMMU cr0 %#x->%#x gfsr=%#x gfsynr0=%#x gfsynr1(sid)=%#x gfsynr2=%#x gfar=%#x%08x cbfsr=%#x cbfar=%#x%08x cbfsynr0=%#x | ifdis=%#x | GPI pre ch0=%#x ch1=%#x ev=%#x | ev=%#x ch0=%#x ch1=%#x "
+	panic("RAIN TOUCH C13: step %u '%s' err=%d xf=%u smmu=%d cb=%d | SMMU cr0 %#x->%#x gfsr=%#x gfsynr0=%#x gfsynr1(sid)=%#x gfsynr2=%#x gfar=%#x%08x cbfsr=%#x cbfar=%#x%08x cbfsynr0=%#x | ifdis=%#x | GPI pre ch0=%#x ch1=%#x ev=%#x | ev=%#x ch0=%#x ch1=%#x "
 	    "go0=%#x go1=%#x | FAIL ch0=%#x ch1=%#x rp0=%#x wp0=%#x evrp=%#x type=%#x glob=%#x gpii=%#x "
-	    "err=%#x src=%#x | ev n=%u w2=%#x w3=%#x rx=%#x %#x %#x imm=%u uc=%d pa=%#llx | cached %02x %02x %02x %02x | id %02x %02x %02x %02x %02x %02x | old %02x %02x %02x %02x %02x %02x | lb %02x %02x %02x %02x %02x %02x %02x %02x | pins %x %x %x %x | e3 nv=%u slot=%u smr=%#x s2cr=%#x sctlr=%#x id=%d | cbf %d fsr=%#x far=%#x syn=%#x sid=%#x | FW pa=%#x len=%#x parts=%u try=%u wrote=%#x err=%d rst %02x %02x crcflag=%#x rilm=%#x rdlm=%#x | INFO %02x %02x x%u y%u max %u %u | TOUCH polls=%u downs=%u panel %u,%u hid %u,%u raw %02x %02x %02x %02x %02x %02x %02x",
+	    "err=%#x src=%#x | ev n=%u w2=%#x w3=%#x rx=%#x %#x %#x imm=%u uc=%d pa=%#llx | cached %02x %02x %02x %02x | id %02x %02x %02x %02x %02x %02x | old %02x %02x %02x %02x %02x %02x | lb %02x %02x %02x %02x %02x %02x %02x %02x | pins %x %x %x %x | e3 nv=%u slot=%u smr=%#x s2cr=%#x sctlr=%#x id=%d | cbf %d fsr=%#x far=%#x syn=%#x sid=%#x | FW pa=%#x len=%#x parts=%u try=%u wrote=%#x err=%d rst %02x %02x crcflag=%#x rilm=%#x rdlm=%#x | INFO %02x %02x x%u y%u max %u %u | TOUCH polls=%u downs=%u panel %u,%u hid %u,%u raw %02x %02x %02x %02x %02x %02x %02x | T3 frames=%u empty=%u maxfingers=%u ids=%#x id1 %u,%u -> %u,%u hid down=%u up=%u | first %02x %02x %02x %02x %02x %02x / %02x %02x %02x %02x %02x %02x / %02x %02x %02x %02x %02x %02x",
 	    rain_step, rn.stage ? rn.stage : "?", rn.err, rn.xfers, rain_smmu, sm.cb,
 	    sm.cr0_was, sm.cr0_now, sm.gfsr, sm.gfsynr0, sm.gfsynr1, sm.gfsynr2, sm.gfar_hi, sm.gfar_lo,
 	    sm.cbfsr, sm.cbfar_hi, sm.cbfar_lo, sm.cbfsynr0, rn.ifdis,
@@ -1747,7 +1774,11 @@ rain_touch_report(void)
 	    nf.fwpa, nf.fwlen, nf.nparts, nf.tries, nf.wrote, nf.err, nf.rst[0], nf.rst[1], nf.crcflag, nf.rilm, nf.rdlm,
 	    nf.info[0], nf.info[1], nf.info[2], nf.info[3], ((uint32_t)nf.info[4] << 8) | nf.info[5], ((uint32_t)nf.info[6] << 8) | nf.info[7],
 	    nf.polls, nf.downs, nf.fx, nf.fy, nf.lx, nf.ly,
-	    nf.raw[0], nf.raw[1], nf.raw[2], nf.raw[3], nf.raw[4], nf.raw[5], nf.raw[6]);
+	    nf.raw[0], nf.raw[1], nf.raw[2], nf.raw[3], nf.raw[4], nf.raw[5], nf.raw[6],
+	    nf.t3_frames, nf.t3_empty, nf.t3_max, nf.t3_ids, nf.t3_x0, nf.t3_y0, nf.t3_x1, nf.t3_y1, st.s_down, st.s_up,
+	    nf.t3_first[0], nf.t3_first[1], nf.t3_first[2], nf.t3_first[3], nf.t3_first[4], nf.t3_first[5],
+	    nf.t3_first[6], nf.t3_first[7], nf.t3_first[8], nf.t3_first[9], nf.t3_first[10], nf.t3_first[11],
+	    nf.t3_first[12], nf.t3_first[13], nf.t3_first[14], nf.t3_first[15], nf.t3_first[16], nf.t3_first[17]);
 }
 
 static void
@@ -1770,7 +1801,7 @@ touch_thread(void *arg, wait_result_t result)
 		if (rn.err || !nf.wrote || stop == 1) {
 			rain_touch_report();    /* panics with every reading */
 		}
-		rain_touch_run(stop == 2);
+		rain_touch_run(stop);
 		goto out;
 	}
 	st.stage = "map";
