From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: taynotfound <marztayron@gmail.com>
Date: Sun, 8 Nov 2026 16:00:00 +0100
Subject: [PATCH] rain-0976: touch stage C7, wait for the RX channel's own event

A duplex transfer is done only once the RX channel (chid 1) posts its event;
the RX ring pointer moves at TRE fetch, before data lands. Immediate-data
events (0x30) are copied into the RX buffer.
---
diff --git a/bsd/dev/sweet_touch.c b/bsd/dev/sweet_touch.c
index 02c780a..b659f33 100644
--- a/bsd/dev/sweet_touch.c
+++ b/bsd/dev/sweet_touch.c
@@ -780,6 +780,7 @@ static struct {
 	bool snapped;
 	uint32_t f_ch0, f_ch1, f_rp0, f_wp0, f_evrp, f_type, f_glob, f_gpii, f_err, f_srcch;
 	uint32_t ev_w2, ev_w3, nev;     /* last event seen */
+	uint32_t rx_w3, nimm;           /* last RX-channel event; immediate-data events seen */
 	const char *gstage;
 	bool loopback;                  /* 0975: CONFIG0 loopback for the RX path test */
 	uint8_t lb[8];
@@ -1073,9 +1074,9 @@ rain_gpi_xfer(uint32_t cmd, const uint8_t *tx, uint8_t *rx, unsigned n)
 	rg.tx_wp += 3u;
 	rg_wr(RG_CH_DB(0), (uint32_t)(rg.pa + RM_TX + rg.tx_wp * 16u));
 
-	/* done = TX transfer-complete event (type 0x22, chid 0); duplex also needs the RX ring drained */
+	/* done = TX transfer-complete event (type 0x22, chid 0); duplex also needs the RX one (chid 1):
+	 * the RX ring pointer moves when the TRE is fetched, before the data lands */
 	unsigned need = 1u, got = 0;
-	uint32_t rx_end = (uint32_t)(rg.pa + RM_RX + rg.rx_wp * 16u);
 	bool rx_done = cmd != 3u;
 	struct rain_tre *ev = (struct rain_tre *)(rg.mem + RM_EV);
 	for (unsigned spin = 0; spin < 200000 && (got < need || !rx_done); spin++) {
@@ -1091,11 +1092,19 @@ rain_gpi_xfer(uint32_t cmd, const uint8_t *tx, uint8_t *rx, unsigned n)
 			if (((w3 >> 16) & 0xffu) == 0x22u && (w3 >> 24) == 0u) {
 				got++;
 			}
+			if ((w3 >> 24) == 1u) {
+				rg.rx_w3 = w3;
+				rx_done = true;
+				/* IMMEDIATE_DATA (0x30): up to 8 RX bytes ride in the event, length in w2[3:0] */
+				if (((w3 >> 16) & 0xffu) == 0x30u) {
+					unsigned len = ev[rg.ev_rp].w[2] & 0xfu;
+					memcpy((void *)(rg.mem + RM_RXBUF), (const void *)&ev[rg.ev_rp].w[0], len > 8u ? 8u : len);
+					clean_dcache64((addr64_t)(rg.pa + RM_RXBUF), 0x100, TRUE);
+					rg.nimm++;
+				}
+			}
 			rg.ev_rp++;
 		}
-		if (!rx_done) {
-			rx_done = rg_rd(RG_CH(1) + RC_RP_LO) == rx_end;
-		}
 		if (got < need || !rx_done) {
 			delay(1);
 		}
@@ -1389,15 +1398,15 @@ rain_touch_report(void)
 		printf("RAIN TOUCH: step %u err=%d, rebooting to fastboot\n", rain_step, rn.err);
 		rain_reboot_fastboot();
 	}
-	panic("RAIN TOUCH C6: step %u '%s' err=%d xf=%u smmu=%d cb=%d | SMMU cr0 %#x->%#x gfsr=%#x gfsynr0=%#x gfsynr1(sid)=%#x gfsynr2=%#x gfar=%#x%08x cbfsr=%#x cbfar=%#x%08x cbfsynr0=%#x | ifdis=%#x | GPI pre ch0=%#x ch1=%#x ev=%#x | ev=%#x ch0=%#x ch1=%#x "
+	panic("RAIN TOUCH C7: step %u '%s' err=%d xf=%u smmu=%d cb=%d | SMMU cr0 %#x->%#x gfsr=%#x gfsynr0=%#x gfsynr1(sid)=%#x gfsynr2=%#x gfar=%#x%08x cbfsr=%#x cbfar=%#x%08x cbfsynr0=%#x | ifdis=%#x | GPI pre ch0=%#x ch1=%#x ev=%#x | ev=%#x ch0=%#x ch1=%#x "
 	    "go0=%#x go1=%#x | FAIL ch0=%#x ch1=%#x rp0=%#x wp0=%#x evrp=%#x type=%#x glob=%#x gpii=%#x "
-	    "err=%#x src=%#x | ev n=%u w2=%#x w3=%#x pa=%#llx | id %02x %02x %02x %02x %02x %02x | old %02x %02x %02x %02x %02x %02x | lb %02x %02x %02x %02x %02x %02x %02x %02x | pins %x %x %x %x",
+	    "err=%#x src=%#x | ev n=%u w2=%#x w3=%#x rx=%#x imm=%u pa=%#llx | id %02x %02x %02x %02x %02x %02x | old %02x %02x %02x %02x %02x %02x | lb %02x %02x %02x %02x %02x %02x %02x %02x | pins %x %x %x %x",
 	    rain_step, rn.stage ? rn.stage : "?", rn.err, rn.xfers, rain_smmu, sm.cb,
 	    sm.cr0_was, sm.cr0_now, sm.gfsr, sm.gfsynr0, sm.gfsynr1, sm.gfsynr2, sm.gfar_hi, sm.gfar_lo,
 	    sm.cbfsr, sm.cbfar_hi, sm.cbfar_lo, sm.cbfsynr0, rn.ifdis,
 	    rg.pre_ch0, rg.pre_ch1, rg.pre_ev, rg.st_ev, rg.st_ch0, rg.st_ch1, rg.st_go0, rg.st_go1,
 	    rg.f_ch0, rg.f_ch1, rg.f_rp0, rg.f_wp0, rg.f_evrp, rg.f_type, rg.f_glob, rg.f_gpii,
-	    rg.f_err, rg.f_srcch, rg.nev, rg.ev_w2, rg.ev_w3, (unsigned long long)rg.pa,
+	    rg.f_err, rg.f_srcch, rg.nev, rg.ev_w2, rg.ev_w3, rg.rx_w3, rg.nimm, (unsigned long long)rg.pa,
 	    rn.id[0], rn.id[1], rn.id[2], rn.id[3], rn.id[4], rn.id[5],
 	    rn.id_old[0], rn.id_old[1], rn.id_old[2], rn.id_old[3], rn.id_old[4], rn.id_old[5],
 	    rg.lb[0], rg.lb[1], rg.lb[2], rg.lb[3], rg.lb[4], rg.lb[5], rg.lb[6], rg.lb[7],
