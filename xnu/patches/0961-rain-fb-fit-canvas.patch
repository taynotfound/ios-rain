 	if (s->scanoutPhys != 0 && s->bytesPerElement == 4 &&
 	    s->width >= fWidth && s->height >= fHeight) {
 		/* full-screen surface: panel window at the logical offset */
@@ -1349,6 +1460,11 @@
 	 * framebuffer showed every multi-layer frame (dims, apps) drawn top-down.
