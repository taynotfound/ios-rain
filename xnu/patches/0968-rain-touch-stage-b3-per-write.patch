From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: taynotfound <marztayron@gmail.com>
Date: Sun, 8 Nov 2026 03:05:00 +0100
Subject: [PATCH] rain-0968: touch stage B3, one breadcrumb per GPI-mode write

B2 reset the phone inside its step 2 (after the GPII 0 reads of step 1
succeeded). Split that step so each write gets its own breadcrumb and
pause: 2 SE0 IRQ routing off, 3 SE0 DMA mode, 4 SE0 GSI events, 5 GPII 0
INTSET (first GPI register write); later steps renumber to 6..12.
---
diff --git a/bsd/dev/sweet_touch.c b/bsd/dev/sweet_touch.c
--- a/bsd/dev/sweet_touch.c
+++ b/bsd/dev/sweet_touch.c
@@ -848,19 +848,27 @@
 		return -23;                     /* someone else owns GPII 0: touch nothing */
 	}
 
-	if (rain_bc(2, "se0 gpi mode")) {
+	/* SE0 into GPI mode (qcom-geni-se: select_gpi_mode), one write per step */
+	if (rain_bc(2, "se0 irq off")) {
 		return -40;
 	}
-	/* SE0 into GPI mode (qcom-geni-se: select_gpi_mode) */
 	touch_wr(rn.se, 0xe1c, 0);
 	touch_wr(rn.se, SE_IRQ_EN, 0);
+	if (rain_bc(3, "se0 dma mode")) {
+		return -40;
+	}
 	touch_wr(rn.se, SE_DMA, 1);
+	if (rain_bc(4, "se0 gsi events")) {
+		return -40;
+	}
 	touch_wr(rn.se, 0xe18, touch_rd(rn.se, 0xe18) | 0xfu);
-
+	if (rain_bc(5, "gpi intset")) {
+		return -40;
+	}
 	rg_wr(RG_INTSET, 1);
 
 	rg.gstage = "ev alloc";
-	if (rain_bc(3, "ev alloc cmd")) {
+	if (rain_bc(6, "ev alloc cmd")) {
 		return -40;
 	}
 	rg_wr(RG_EV_CMD, (0u << 24) | 0u);
@@ -869,7 +877,7 @@
 		return -24;
 	}
 	rg.st_ev = rg_rd(RG_EV + RC_CFG);
-	if (rain_bc(4, "ev ctx + doorbell")) {
+	if (rain_bc(7, "ev ctx + doorbell")) {
 		return -40;
 	}
 	rain_gpi_ring_ctx(RG_EV, (16u << 24) | (1u << 16) | 2u, RM_EV, RG_NEV * 16u, RG_EV_DB);
@@ -883,7 +891,7 @@
 
 	for (uint32_t k = 0; k < 2; k++) {
 		rg.gstage = k ? "ch1 alloc" : "ch0 alloc";
-		if (rain_bc(5u + k, rg.gstage)) {
+		if (rain_bc(8u + k, rg.gstage)) {
 			return -40;
 		}
 		rg_wr(RG_CH_CMD, (0u << 24) | k);
@@ -908,7 +916,7 @@
 	__asm__ volatile("dsb sy" ::: "memory");
 	for (uint32_t k = 0; k < 2; k++) {
 		rg.gstage = k ? "ch1 start" : "ch0 start";
-		if (rain_bc(7u + k, rg.gstage)) {
+		if (rain_bc(10u + k, rg.gstage)) {
 			return -40;
 		}
 		rg_wr(RG_CH_CMD, (1u << 24) | k);
@@ -967,7 +975,7 @@
 	clean_dcache64((addr64_t)(rg.pa + RM_TXBUF), 0x100, TRUE);
 	flush_dcache64((addr64_t)(rg.pa + RM_RXBUF), 0x100, TRUE);
 	__asm__ volatile("dsb sy" ::: "memory");
-	if (rn.xfers == 0 && rain_bc(9, "first doorbell (DMA)")) {
+	if (rn.xfers == 0 && rain_bc(12, "first doorbell (DMA)")) {
 		return -40;
 	}
 	if (cmd == 3u) {
@@ -1239,7 +1247,7 @@
 static void
 rain_touch_report(void)
 {
-	panic("RAIN TOUCH B2: step %u '%s' err=%d xf=%u ifdis=%#x | GPI pre ch0=%#x ch1=%#x ev=%#x | ev=%#x ch0=%#x ch1=%#x "
+	panic("RAIN TOUCH B3: step %u '%s' err=%d xf=%u ifdis=%#x | GPI pre ch0=%#x ch1=%#x ev=%#x | ev=%#x ch0=%#x ch1=%#x "
 	    "go0=%#x go1=%#x | FAIL ch0=%#x ch1=%#x rp0=%#x wp0=%#x evrp=%#x type=%#x glob=%#x gpii=%#x "
 	    "err=%#x src=%#x | ev n=%u w2=%#x w3=%#x pa=%#llx | id %02x %02x %02x %02x %02x %02x",
 	    rain_step, rn.stage ? rn.stage : "?", rn.err, rn.xfers, rn.ifdis,
