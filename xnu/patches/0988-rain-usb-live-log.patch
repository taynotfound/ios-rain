From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: taynotfound <marztayron@gmail.com>
Date: Wed, 11 Nov 2026 21:00:00 +0100
Subject: [PATCH] rain-0988: sweet's USB device mode and live log on rain

sweet (SM7150) streams the kernel console over USB Ethernet (0072-0077);
topaz never ported it (sweethw=1 only). rain addresses: GCC 0x1400000 with
the usb30_prim GDSC at 0x1a004 and gcc-khaje.c branch clocks, DWC3 core at
0x4e00000 (qscratch +0xf8800), no QUSB2 (SNPS femto PHY). Device-mode DMA
gets an SMMU identity bank for SID 0x120. Opt-in: sweetusb=1 reports the
controller state, sweetusb=2 starts the device and the log (UDP 5140).
---
diff --git a/bsd/dev/sweet_ufs.c b/bsd/dev/sweet_ufs.c
index 143db60..ba7bc05 100644
--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -823,11 +823,9 @@ sweet_ufs_init(void)
 	(void)PE_parse_boot_argn("sweethw", &hw, sizeof(hw));
 	sweet_touch_init();
 	sweet_keys_init();
-	if (hw == 1) {
-		sweet_usb_probe();
-	} else {
-		printf("SWEET UFS: USB skipped (topaz, sweethw=0)\n");
-	}
+	/* rain: the USB driver has rain's addresses and only runs with boot-arg sweetusb=N */
+	(void)hw;
+	sweet_usb_probe();
 	return 0;
 }
 
diff --git a/bsd/dev/sweet_usb.c b/bsd/dev/sweet_usb.c
index 9c42e45..0c72ffc 100644
--- a/bsd/dev/sweet_usb.c
+++ b/bsd/dev/sweet_usb.c
@@ -37,28 +37,34 @@
 extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
 void sweet_usb_probe(void);
 static void sweet_usb_gadget_start(vm_offset_t dwc);
+extern bool topaz_smmu_identity(uint32_t sid, uint32_t mask, const char *name);
 extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
 
-#define GCC_PA                  0x00100000
-#define GCC_SIZE                0x00090000
-#define GCC_USB30_PRIM_GDSCR    0x0f004         /* bit 31: power on */
+/*
+ * rain (SM6225 khaje): GCC 0x1400000, usb30_prim GDSC 0x141a004 (DT), branch clocks from
+ * Xiaomi's gcc-khaje.c; DWC3 core 0x4e00000 (DT ssusb@4e00000, qscratch at core + 0xf8800);
+ * the HS PHY is a SNPS femto at 0x1613000, not a QUSB2: not read.
+ */
+#define GCC_PA                  0x01400000
+#define GCC_SIZE                0x000a0000
+#define GCC_USB30_PRIM_GDSCR    0x1a004         /* bit 31: power on */
 #define CBCR_CLK_OFF            (1u << 31)
 
 static const struct {
 	const char *name;
 	uint32_t    off;
 } usb_cbcr[] = {
-	{ "master", 0x0f010 },
-	{ "sleep", 0x0f014 },
-	{ "utmi", 0x0f018 },
-	{ "cfg-noc-axi", 0x0502c },
-	{ "aggre-axi", 0x8201c },
-	{ "ahb2phy", 0x6a004 },
-	{ "clkref", 0x8c010 },
+	{ "master", 0x1a010 },
+	{ "sleep", 0x1a014 },
+	{ "utmi", 0x1a018 },
+	{ "cfg-noc-axi", 0x1a084 },
+	{ "sys-noc-axi", 0x1a080 },
+	{ "ahb2phy", 0x1d008 },
+	{ "clkref", 0x9f000 },
 };
 
-#define DWC3_PA                 0x0a600000
-#define DWC3_SIZE               0x0000d000
+#define DWC3_PA                 0x04e00000
+#define DWC3_SIZE               0x0000e000
 #define QUSB2_PA                0x088e2000
 #define QUSB2_SIZE              0x00000400
 
@@ -73,7 +79,7 @@ usb_rd(vm_offset_t base, uint32_t off)
 void
 sweet_usb_probe(void)
 {
-	int enabled = 1;
+	int enabled = 0;                /* rain: only with boot-arg sweetusb=1 (report) or 2 (device) */
 	uint32_t gdscr, cbcr[sizeof(usb_cbcr) / sizeof(usb_cbcr[0])];
 	bool clocks_on = true;
 
@@ -116,6 +122,9 @@ sweet_usb_probe(void)
 	if (enabled >= 2) {
 		sweet_usb_gadget_start(dwc);
 	}
+	if (enabled) {
+		return;         /* rain: no QUSB2 here (SNPS femto PHY at 0x1613000) */
+	}
 	if (cbcr[5] & CBCR_CLK_OFF) {
 		printf("SWEET USB: ahb2phy clock off; QUSB2 PHY not read\n");
 		return;
@@ -164,7 +173,7 @@ sweet_usb_probe(void)
  * session; Linux dwc3-qcom forces that in software when the charger
  * reports a cable (dwc3_qcom_vbus_override_enable).
  */
-#define QSCRATCH_PA             0x0a6f8800
+#define QSCRATCH_PA             0x04ef8800
 #define QSCRATCH_HS_PHY_CTRL    0x10
 #define   UTMI_OTG_VBUS_VALID   (1u << 20)
 #define   SW_SESSVLD_SEL        (1u << 28)
@@ -828,6 +837,11 @@ sweet_usb_gadget_start(vm_offset_t dwc)
 		return;
 	}
 	ud.dma_pa = ptoa_64(pn);
+	/* rain: the DWC3's DMA goes through the apps SMMU (DT iommus = <&apps_smmu 0x120 0x0>) */
+	if (!topaz_smmu_identity(0x120u, 0u, "USB")) {
+		printf("SWEET USB: no SMMU identity bank for SID 0x120: device mode not started\n");
+		return;
+	}
 	ud_if_create();
 
 	/* Device controller soft reset (PHY and global setup stay as ABL left them). */
