From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: taynotfound <marztayron@gmail.com>
Date: Sun, 8 Nov 2026 15:20:00 +0100
Subject: [PATCH] rain-0974: touch stage C5, Novatek SPI engine reset first

All eight GPI transfers now complete on the phone, but the chip-ID read
returns zeros. The Xiaomi nt36525b driver resets the touch IC SPI engine
(0x5a to 0x7fff80, then 1 ms) before the bootloader reset and the trim-ID
read; do the same. Report both ID reads (0x3f004 and 0x1f64e).
---
diff --git a/bsd/dev/sweet_touch.c b/bsd/dev/sweet_touch.c
--- a/bsd/dev/sweet_touch.c
+++ b/bsd/dev/sweet_touch.c
@@ -641,6 +641,7 @@
 #define RAIN_SPI_DELAYS   0x278u
 #define RAIN_OP_TX        1u          /* SPI_TX_ONLY */
 #define RAIN_OP_FULL      3u          /* SPI_FULL_DUPLEX */
+#define RAIN_NVT_ENGRST   0x7fff80u   /* SPI engine reset, written before anything else */
 #define RAIN_NVT_RST      0x3f0feu    /* DT novatek,swrst-n8-addr */
 #define RAIN_NVT_RDFAST   0x3f310u    /* DT novatek,spi-rd-fast-addr */
 #define RAIN_NVT_TRIM     0x3f004u
@@ -1311,8 +1312,15 @@
 	rn.k_se2cmd = touch_rd(st.gcc, TOUCH_RCG);         /* topaz SE2, known good, read only */
 	rn.k_se2cfg = touch_rd(st.gcc, TOUCH_RCG + 4u);
 
+	rn.stage = "nvt eng reset";
+	int e = rain_nvt_write(RAIN_NVT_ENGRST, 0x5a);
+	if (e) {
+		rn.err = e;
+		return;
+	}
+	touch_wait(1);
 	rn.stage = "nvt reset";
-	int e = rain_nvt_write(RAIN_NVT_RST, 0x69);
+	e = rain_nvt_write(RAIN_NVT_RST, 0x69);
 	if (e == -4) {
 		rn.stage = "retry root_en";
 		touch_wr(st.gcc, RAIN_RCG_SE0, touch_rd(st.gcc, RAIN_RCG_SE0) | 2u);   /* ROOT_EN */
@@ -1372,16 +1380,17 @@
 		printf("RAIN TOUCH: step %u err=%d, rebooting to fastboot\n", rain_step, rn.err);
 		rain_reboot_fastboot();
 	}
-	panic("RAIN TOUCH C4: step %u '%s' err=%d xf=%u smmu=%d cb=%d | SMMU cr0 %#x->%#x gfsr=%#x gfsynr0=%#x gfsynr1(sid)=%#x gfsynr2=%#x gfar=%#x%08x cbfsr=%#x cbfar=%#x%08x cbfsynr0=%#x | ifdis=%#x | GPI pre ch0=%#x ch1=%#x ev=%#x | ev=%#x ch0=%#x ch1=%#x "
+	panic("RAIN TOUCH C5: step %u '%s' err=%d xf=%u smmu=%d cb=%d | SMMU cr0 %#x->%#x gfsr=%#x gfsynr0=%#x gfsynr1(sid)=%#x gfsynr2=%#x gfar=%#x%08x cbfsr=%#x cbfar=%#x%08x cbfsynr0=%#x | ifdis=%#x | GPI pre ch0=%#x ch1=%#x ev=%#x | ev=%#x ch0=%#x ch1=%#x "
 	    "go0=%#x go1=%#x | FAIL ch0=%#x ch1=%#x rp0=%#x wp0=%#x evrp=%#x type=%#x glob=%#x gpii=%#x "
-	    "err=%#x src=%#x | ev n=%u w2=%#x w3=%#x pa=%#llx | id %02x %02x %02x %02x %02x %02x",
+	    "err=%#x src=%#x | ev n=%u w2=%#x w3=%#x pa=%#llx | id %02x %02x %02x %02x %02x %02x | old %02x %02x %02x %02x %02x %02x",
 	    rain_step, rn.stage ? rn.stage : "?", rn.err, rn.xfers, rain_smmu, sm.cb,
 	    sm.cr0_was, sm.cr0_now, sm.gfsr, sm.gfsynr0, sm.gfsynr1, sm.gfsynr2, sm.gfar_hi, sm.gfar_lo,
 	    sm.cbfsr, sm.cbfar_hi, sm.cbfar_lo, sm.cbfsynr0, rn.ifdis,
 	    rg.pre_ch0, rg.pre_ch1, rg.pre_ev, rg.st_ev, rg.st_ch0, rg.st_ch1, rg.st_go0, rg.st_go1,
 	    rg.f_ch0, rg.f_ch1, rg.f_rp0, rg.f_wp0, rg.f_evrp, rg.f_type, rg.f_glob, rg.f_gpii,
 	    rg.f_err, rg.f_srcch, rg.nev, rg.ev_w2, rg.ev_w3, (unsigned long long)rg.pa,
-	    rn.id[0], rn.id[1], rn.id[2], rn.id[3], rn.id[4], rn.id[5]);
+	    rn.id[0], rn.id[1], rn.id[2], rn.id[3], rn.id[4], rn.id[5],
+	    rn.id_old[0], rn.id_old[1], rn.id_old[2], rn.id_old[3], rn.id_old[4], rn.id_old[5]);
 }
 
 static void
